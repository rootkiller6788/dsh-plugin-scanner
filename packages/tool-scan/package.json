{
  "name": "dsh-tool-plugin-scan",
  "version": "0.1.0",
  "type": "module",
  "description": "Consumer for the dsh plugin scanner: a model-facing scan_plugin tool and a human-facing /scan command over ctx.pluginScan",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-plugin-scan": "workspace:*",
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-commands": "workspace:*"
  },
  "devDependencies": {
    "dsh-plugin-scan": "workspace:*",
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-commands": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*"
  }
}
